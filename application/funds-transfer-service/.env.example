# Names only. Copy to .env (git-ignored) or inject from your secret store; never commit values.
FUNDS_DB_URL=jdbc:oracle:thin:@//<host>:1521/FREEPDB1
FUNDS_DB_USER=FUNDS_APP
FUNDS_DB_PASSWORD=
FUNDS_DB_SCHEMA=FUNDS_OWNER
FUNDS_JWT_ISSUER_URI=https://<idp>/
# Migrations (separate identity, only when FLYWAY_ENABLED=true)
FLYWAY_ENABLED=false
FUNDS_MIGRATION_DB_USER=FUNDS_OWNER
FUNDS_MIGRATION_DB_PASSWORD=
# Optional
FUNDS_KAFKA_BOOTSTRAP_SERVERS=localhost:9092
