# Names only. Copy to .env (git-ignored) or inject from your secret store; never commit values.
FUNDS_DB_URL=jdbc:oracle:thin:@//<host>:1521/FREEPDB1
FUNDS_DB_USER=FUNDS_APP
FUNDS_DB_PASSWORD=
FUNDS_DB_SCHEMA=FUNDS_OWNER
FUNDS_JWT_ISSUER_URI=https://<idp>/
# Migrations (separate identity, only when FLYWAY_ENABLED=true)
FLYWAY_ENABLED=false
FUNDS_MIGRATION_DB_USER=FUNDS_OWNER
FUNDS_MIGRATION_DB_PASSWORD=
# Optional: Kafka (docs/release-2-event-streaming.md). Publisher and consumer are off unless enabled here.
FUNDS_KAFKA_BOOTSTRAP_SERVERS=localhost:9092
FUNDS_OUTBOX_PUBLISHER_ENABLED=false
FUNDS_NOTIFICATIONS_CONSUMER_ENABLED=false
# Only on a single-broker dev box; shared clusters get topics from the platform.
FUNDS_KAFKA_CREATE_TOPICS=false
# Browser origins allowed to call this API (comma-separated). Empty = no browser origin allowed.
# For the local banking-ui dev server: FUNDS_CORS_ALLOWED_ORIGINS=http://localhost:5173
FUNDS_CORS_ALLOWED_ORIGINS=http://localhost:5173
