# Backend API base URL (Spring Boot funds-transfer-service), including /api/v1.
VITE_API_URL=http://localhost:8080/api/v1

# "keycloak" for real Authorization Code + PKCE login against an OIDC provider,
# or "dev" for the local mock sign-in screen (no real credentials, no real backend calls
# unless VITE_USE_MOCKS=false and a real bearer token is pasted in).
VITE_AUTH_MODE=dev

# When true, MSW intercepts API calls in the browser with realistic fake data so the app
# is usable without a running backend/Oracle/Keycloak. Set to false against a real backend.
VITE_USE_MOCKS=true

# Only used when VITE_AUTH_MODE=keycloak. VITE_KEYCLOAK_URL is the server root — keycloak-js
# appends /realms/<realm>/... itself. The resulting issuer must equal the backend's
# FUNDS_JWT_ISSUER_URI (http://10.30.11.104:8180/realms/funds-transfer) character for character.
VITE_KEYCLOAK_URL=http://10.30.11.104:8180
VITE_KEYCLOAK_REALM=funds-transfer
# Public client, Standard flow + PKCE (S256), no client secret. Confirm this ID exists in the realm.
VITE_KEYCLOAK_CLIENT_ID=banking-web
