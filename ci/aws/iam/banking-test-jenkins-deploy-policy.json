{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "PublishTestArtifacts",
      "Effect": "Allow",
      "Action": [
        "s3:PutObject",
        "s3:GetObject"
      ],
      "Resource": "arn:aws:s3:::eftabankingnvddatavdc/jenkins-artifacts/banking-app/test/releases/*"
    },
    {
      "Sid": "SendCommandsToTestApplication",
      "Effect": "Allow",
      "Action": "ssm:SendCommand",
      "Resource": [
        "arn:aws:ssm:us-east-1::document/AWS-RunShellScript",
        "arn:aws:ec2:us-east-1:866317130608:instance/i-0ded4009e54c9c1cd"
      ]
    },
    {
      "Sid": "ReadDeploymentResults",
      "Effect": "Allow",
      "Action": [
        "ssm:GetCommandInvocation",
        "ssm:ListCommandInvocations"
      ],
      "Resource": "*"
    }
  ]
}
