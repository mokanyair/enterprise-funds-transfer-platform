# Terraform working directories
**/.terraform/*

# Terraform state
*.tfstate
*.tfstate.*
*.tfstate.backup

# Terraform plans
*.tfplan
*-plan.txt
plan.out

# Crash logs
crash.log
crash.*.log

# Variable files that may contain secrets
*.tfvars
*.tfvars.json

# Keep examples
!*.tfvars.example

# Ansible
*.retry

# Python
__pycache__/
*.py[cod]

# IDE / OS
.vscode/
.idea/
.DS_Store

# Build output (Maven), including the generated bundled OpenAPI spec
target/

# Local environment files may hold credentials; only .env.example is tracked
.env
*.env
!.env.example
